{
  "name": "discord-bug-tracker",
  "version": "1.0.0",
  "description": "Discord bot that turns #bug-reports threads into Notion tickets, feature-request threads into Notion requests, and announces finished ones in #releases",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node src/register-commands.js",
    "test": "node --test test/*.test.js",
    "users:audit": "node src/audit-users.js"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "openai": "^4.77.0",
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.7"
  }
}
