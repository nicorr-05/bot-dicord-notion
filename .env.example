# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_discord_server_id
# Channel where "bug resuelto" is announced when the ticket has no Discord thread.
# Optional: if empty, the bot looks up the channel named "bug-reports" in the guild.
DISCORD_BUG_CHANNEL_ID=

# Channel where finished tickets are announced as releases.
# Optional: if empty, the bot looks up the channel named "releases" in the guild.
DISCORD_RELEASES_CHANNEL_ID=
DISCORD_RELEASES_CHANNEL_NAME=releases
# Safety valve: a poll that finds more unannounced tickets than this publishes
# nothing, so an interrupted back-fill can't dump the backlog into the channel.
RELEASES_MAX_PER_POLL=20
# Minutes a ticket must sit untouched before it is announced, so marking it Done
# and attaching its release video can happen in either order. 0 = announce on the
# next poll.
RELEASES_QUIET_MINUTES=10

# ─── Resumen semanal de releases ──────────────────────────────────────────────
# Friday 15:30 Venezuela time by default. Set ENABLED=false to turn the digest off.
WEEKLY_DIGEST_ENABLED=true
WEEKLY_DIGEST_WEEKDAY=Fri
WEEKLY_DIGEST_TIME=15:30
WEEKLY_DIGEST_TIMEZONE=America/Caracas

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Notion ───────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=24a8a66068d88099b008df8f24b8dad9
# Notion user pre-selected as assignee on every new ticket (optional).
# Leave empty to create tickets unassigned. Find IDs via GET https://api.notion.com/v1/users
NOTION_DEFAULT_ASSIGNEE_ID=
# How often Notion is polled for tickets that reached a completed status. Default: 5.
NOTION_POLL_INTERVAL_MINUTES=5
# The Discord <-> Notion identity table lives in src/config/user-links.js
