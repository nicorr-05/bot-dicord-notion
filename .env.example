# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_discord_server_id
# Channel where "bug resuelto" is announced when the ticket has no Discord thread.
# Optional: if empty, the bot looks up the channel named "bug-reports" in the guild.
DISCORD_BUG_CHANNEL_ID=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Notion ───────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=24a8a66068d88099b008df8f24b8dad9
# Notion user pre-selected as assignee on every new ticket (optional).
# Leave empty to create tickets unassigned. Find IDs via GET https://api.notion.com/v1/users
NOTION_DEFAULT_ASSIGNEE_ID=
# How often Notion is polled for tickets that reached a completed status. Default: 5.
NOTION_POLL_INTERVAL_MINUTES=5
# The Discord <-> Notion identity table lives in src/config/user-links.js
